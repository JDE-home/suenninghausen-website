# Kopie als ".env" ablegen und anpassen (die Datei .env wird NICHT ins Git übernommen).

# Zugang für den ersten Administrator. Wird nur beim allerersten Start benutzt;
# danach wird das Passwort in der Verwaltung unter "Passwort" geändert.
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-ein-langes-eigenes-passwort

# Wo die Daten liegen (Termine, Vereine, Verlauf, Benutzer). Dieses Verzeichnis sichern!
DATA_DIR=./data

# Optional: eigener Schlüssel für Anmelde-Cookies (mind. 32 Zeichen). Ohne Angabe wird einer erzeugt.
# SESSION_SECRET=

# Server (für Docker bereits gesetzt)
# HOST=0.0.0.0
# PORT=4321
